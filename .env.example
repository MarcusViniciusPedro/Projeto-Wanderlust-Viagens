# Exemplo de configuracao da aplicacao Wanderlust Viagens.
# Copie para .env e preencha com valores reais. NAO commite o .env.
# Nenhum valor abaixo e um segredo real.

# ----------------------------------------------------------------------------
# Banco de dados SQL Server (opcional; a app importa e roda sem DB vivo).
# A conexao so e aberta quando um recurso que precisa do banco e usado.
# ----------------------------------------------------------------------------
WANDERLUST_DB_SERVER=localhost
WANDERLUST_DB_PORT=1433
WANDERLUST_DB_NAME=wanderlust
WANDERLUST_DB_USER=sa
WANDERLUST_DB_PASSWORD=troque-esta-senha

# ----------------------------------------------------------------------------
# Autenticacao / seguranca
# ----------------------------------------------------------------------------
# Segredo usado para assinar os tokens JWT. Gere um valor aleatorio forte.
WANDERLUST_JWT_SECRET=troque-este-segredo-jwt
# Algoritmo e tempo de expiracao do token de acesso (minutos).
WANDERLUST_JWT_ALGORITHM=HS256
WANDERLUST_JWT_EXPIRE_MINUTES=60
# Emissor exibido nos apps de autenticacao 2FA/TOTP.
WANDERLUST_TOTP_ISSUER=Wanderlust Viagens

# ----------------------------------------------------------------------------
# Integracoes externas (stubs configuraveis; vazias = modo stub/desativado).
# ----------------------------------------------------------------------------
# Envio de SMS (ex.: codigo 2FA por SMS).
WANDERLUST_SMS_API_KEY=
WANDERLUST_SMS_SENDER=

# Envio de e-mail (confirmacoes, recuperacao de senha).
WANDERLUST_EMAIL_API_KEY=
WANDERLUST_EMAIL_FROM=nao-responder@wanderlust.example

# Gateway de pagamento.
WANDERLUST_PAYMENT_API_KEY=
WANDERLUST_PAYMENT_BASE_URL=

# Google Street View (visualizacao de destinos).
WANDERLUST_STREETVIEW_API_KEY=
